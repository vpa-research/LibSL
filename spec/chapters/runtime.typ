#import "../meta.typ": *
#import "../types.typ": type-expr, builtin-types, ctor, ptr, union as ty-union

#rule-h(<rt>)
= Динамическая семантика

#rule(<rt.intro>)
Данный раздел посвящён динамическим аспектам поведения языковых конструкций.

#rule-h(<rt.value>)
== Значения

#rule(<rt.value.intro>)
#def("value")[Значение] — представление данных во время исполнения.
Значения получаются в результате @def:expr-eval[вычисления] выражений; при помощи выражений также над ними производятся операции и преобразования.

#rule(<rt.value.dyn-type>)
Значения в LibSL типизированы.
Для этого у каждого содержится информация об его #def("dynamic-type")[Динамический тип][динамическом типе].
Информация о динамическом типе используется для реализации @def:type-comparison-expr[сравнения типов] и @def:cast[приведения].

Динамический тип определяет пространство значений и допустимые операции над ними.
Динамический тип каждого значения определён однозначно и остаётся постоянным; динамические типы попарно не пересекаются.

В качестве некоторых динамических типов используются @def:type[статические].

#note[
  Так как выражения, вычисляющие одно и то же значение, могут иметь различные @def:type[статические типы], соответствие между ними и дмнамическими типами неоднозначно.
  Так, например, тип #type-expr(builtin-types.any) может содержать все значения.
]

#rule(<rt.value.identity>)
Каждое значение имеет свою #def("value-identity")[Идентичность значения][идентичность].
Оно однозначно определяет значение.
Значения с равными идентичностями называются #def("value-eq")[Идентичные значения][идентичными].
Два значения с одинаковыми идентичности неотличимы друг от друга.
Значения различных динамических типов имеют различные идентичности.

#rule(<rt.value.kinds>)
В LibSL имеются следующие виды значений:

#let values = state("values", ())
#let value-kind(value, dyn-type) = values.update(vs => vs + ((value, dyn-type),))
#context table(
  columns: 2,

  table.header[*Вид значения*][*Динамический тип*],

  ..values.final().flatten(),
)

Помимо них @def:processor[процессор] может определять другие виды значений.

#rule-h(<rt.value.bool>)
=== Булевы значения

#rule(<rt.value.bool.intro>)
#value-kind[@def:bool-value][Булевый]
#def("bool-value")[Булево значение] — значение, обозначающее логическую истинность.
Таких значений два: `true` и `false` (они представляют @def:value-identity[идентичность значения]).
`true` обозначает логическую истину, `false` — логическую ложь.

#rule(<rt.value.bool.type>)
@def:dynamic-type булевого значения — булевый.

#rule-h(<rt.value.char>)
=== Символьные значения

#rule(<rt.value.char.intro>)
#value-kind[@def:char-value][Символьный]
#def("char-value")[Символьное значение] — значение, представляющий один @def:character[символ] Unicode.
У каждого символьного значения есть код, соответствующий Unicode codepoint, который представляет @def:value-identity[идентичность значения].

#rule(<rt.value.char.type>)
@def:dynamic-type символьного значения — символьный.

#note[
  В соответствии с определением Unicode, диапазон значений символьного динамического типа — символы с кодами от U+0000 до U+10FFFF.
]

#rule-h(<rt.value.string>)
=== Строковые значения

#rule(<rt.value.string.intro>)
#value-kind[@def:string-value][Строковый]
#def("string-value")[Строковое значение] — значение, содержащее последовательность @def:character[символов].

#rule(<rt.value.string.repr>)
Представление строкового значения — упорядоченная последовательность из $n$ символов.
Число $n$ называется #def("string-length")[Длина строки][длиной строки].

#note[
  Строка не является последовательностью байт, как это может быть в других языках.
  Как следствие, вопрос о кодировке строки не имеет смысла.
]

#rule(<rt.value.string.identity>)
@def:value-identity[Идентичность] строкового значения определяется последовательностью символов.
Две строки с одинаковыми последовательностями символов @def:value-eq[идентичны].

#rule(<rt.value.string.immutable>)
Строки неизменяемы.

#rule(<rt.value.string.type>)
@def:dynamic-type строкового значения — строковый.

#rule-h(<rt.value.int>)
=== Целочисленные значения

#rule(<rt.value.int.intro>)
#value-kind[@def:int-value][Целочисленные]
#def("int-value")[Целочисленное значение] — значение, являющееся целым числом, которыми являются примитивные целые числа и значения @def:enum-decl[перечислимых типов].

#rule(<rt.value.int.repr>)
Значения представляются в виде двоичного числа с целым числом бит (определяется шириной).
Для представления отрицательных чисел применяется дополнительный код.

#rule(<rt.value.int.type>)
@def:dynamic-type целочисленного значения — один из статических @def:integral-type[целочисленных типов]:

#context {
  let primitive-types = query(<meta:primitive-int-types>).first().value

  table(
    columns: (1.5em, 1.5fr, 1fr, 1fr),
    align: (left + horizon, left + horizon, center + horizon, center + horizon),

    table.header(
      table.cell(colspan: 2)[*Тип*]
    )[*Ширина*][*Знаковый*],

    table.cell(rowspan: primitive-types.len(), rotate(reflow: true, -90deg)[Примитивные типы]),

    ..primitive-types
      .map(it => (
        type-expr(builtin-types.at(it.name)),
        [$#it.width$ бит],
        if it.sign [да] else [нет],
      ))
      .flatten(),

    table.cell(colspan: 2)[@def:enum-decl[Перечислимые типы]],
    table.cell(colspan: 2)[Устанавливается @def:enum-underlying-type[определяющим типом]],
  )
}

#note[
  У значения перечислимого типа $E$ динамическим типом также является $E$.
  Его определяющий тип — например, #type-expr(builtin-types.int32) — отличен от его динамического типа.
]

Целочисленные значения примитивных динамических типов называются #def("primitive-int-value")[Примитивное целочисленное значение][примитивными].

@def:processor[Процессором] могут задаваться дополнительные целочисленные динамические типы.

#rule(<rt.value.int.identity>)
@def:value-identity[Идентичность] целочисленного значения состоит из динамического типа и двоичного представления.

#note[
  Таким образом, значения разных динамических типов (например, $0$ динамических типов #type-expr(builtin-types.int32) и #type-expr(builtin-types.unsigned32)) всегда различны.
  Также значения перечислимых типов @def:value-eq[не идентичны] никаким примитивным целочисленным значениям.
]

#rule-h(<rt.value.float>)
=== Вещественные значения

#rule(<rt.value.float.intro>)
#value-kind[@def:float-value][Вещественные]
#def("float-value")[Вещественное значение] — значение, являющееся числом с плавающей запятой.

#rule(<rt.value.float.repr>)
Представление вещественных значений регламентируется стандартом IEEE 754@ref:ieee.
При выполнении вещественных операций применяется режим округления `roundTiesToEven`.

#def("float-width")[Ширина вещественного значения][Шириной] вещественного значения называется количество бит в его представлении.

#rule(<rt.value.float.type>)
@def:dynamic-type вещественного значения — один из следующих вещественных типов (взаимно однозначно соответствующие статическим типам):

#context {
  let types = query(<meta:float-types>).first().value

  table(
    columns: (2fr, 2fr, 1fr),
    align: center + horizon,

    table.header[*Динамический тип*][*Представление по IEEE 754*][*Ширина*],

    ..types
      .map(it => (
        type-expr(builtin-types.at(it.name)),
        raw(it.repr),
        $#it.width$,
      ))
      .flatten(),
  )
}

@def:processor[Процессором] могут задаваться дополнительные вещественные динамические типы.

#rule(<rt.value.float.identity>)
@def:value-identity[Идентичность] вещественного значения определяется его двоичным представлением.

#note[
  + Вещественные значения разных динамических типов никогда @def:value-eq[не идентичны].

  + Два NaN-значения одного и того же динамического типа @def:value-eq[идентичны], если их двоичные представления побитово равны.
]

#rule-h(<rt.value.null>)
=== Значение `null`

#rule(<rt.value.null.intro>)
#value-kind[@def:null-value][#type-expr(builtin-types.null)]
#def("null-value")[Значение `null`] представляет собой единственное значение типа #type-expr(builtin-types.null), которое также является его @def:value-identity[идентичностью].

#note[
  `null` не является @def:pointer-value[указателем].
]

#rule(<rt.value.null.type>)
@def:dynamic-type значения — #type-expr(builtin-types.null).

#rule-h(<rt.value.void>)
=== Значение `void`

#rule(<rt.value.void.intro>)
#value-kind[@def:void-value][#type-expr(builtin-types.void)]
#def("void-value")[Значение `void`] представляет собой единственное значение типа #type-expr(builtin-types.void), которое также является его @def:value-identity[идентичностью].

#rule(<rt.value.void.type>)
@def:dynamic-type значения — #type-expr(builtin-types.void).

#rule-h(<rt.value.array>)
=== Массивы

#rule(<rt.value.array.intro>)
#value-kind[@def:array-value][#type-expr(ctor(builtin-types.array)($T$))]
#def("array-value")[Массив] — значение, содержащее значения одного и того же @def:type[статического типа].

#rule(<rt.value.array.repr>)
Представление массива — упорядоченная последовательность из $n >= 0$ элементов.
Число $n$ называется #def("array-len")[Длина массива][длиной массива].
Индексы в массиве начинаются с $0$; допустимыми являются индексы $0, ..., n - 1$.
Каждому индексу соответствует некоторое значение.

#rule(<rt.value.array.mutability>)
Содержимое массива может быть изменено посредством @def:assign-stmt[команды присваивания].
Длина массива постоянна и не может быть изменена.

#rule(<rt.value.array.type>)
@def:dynamic-type массива — статический тип #type-expr(ctor(builtin-types.array)($T$)), где $T$ — тип элемента.
Он привязывается к массиву в момент создания и остаётся постоянным.

#note[
  Два пустых массива `[]`, таким образом, могут иметь различные динамические типы.
]

#rule(<rt.value.array.identity>)
@def:value-identity[Идентичность] массива определяется совокупностью его динамического типа, длины и последовательности идентичностей элементов.

#rule-h(<rt.value.set>)
=== Множества

#rule(<rt.value.set.intro>)
#value-kind[@def:set-value][#type-expr(ctor(builtin-types.set)($T$))]
#def("set-value")[Множество] — значение, содержащее набор каких-либо значений одного и того же @def:hashable-type[хэшируемого] @def:type[статического типа].

#rule(<rt.value.set.repr>)
Множество неупорядочено.
Множество не может содержать несколько @def:value-eq[идентичных] значений.
Количество элементов в множестве (его мощность) называется его #def("set-length")[Длина множества][длиной].

#rule(<rt.value.set.mutability>)
Множество неизменяемо.

#rule(<rt.value.set.type>)
@def:dynamic-type множества — статический тип #type-expr(ctor(builtin-types.set)($T$)), где $T$ — тип элемента.
Он привязывается к множеству в момент создания и остаётся постоянным.

#note[
  Два пустых множества `{}`, таким образом, могут иметь различные динамические типы.
]

#rule(<rt.value.set.identity>)
@def:value-identity[Идентичность] множества определяется совокупностью его динамического типа, длины и идентичностями содержащихся в нём элементов.

#unresolved[
  Как идентичность и динамический тип взаимодействуют с @def:covariant-param[ковариантностью] типа элемента?
]

#rule-h(<rt.value.ptr>)
=== Указатели

#rule(<rt.value.ptr.intro>)
#value-kind[@def:pointer-value][Динамические типы указателей]
#def("pointer-value")[Указатель] — значение, адресующее некоторое значение в @def:memory[памяти].

#rule(<rt.value.ptr.repr>)
Представление указателя определяется @def:processor[процессором].

#rule(<rt.value.ptr.type>)
@def:dynamic-type[Динамические типы] указателей определяются @def:processor[процессором].
Они отличны от любых других динамических типов.

#rule(<rt.value.ptr.identity>)
@def:value-identity[Идентичность] указателей определяется @def:processor[процессором].

#rule-h(<rt.value.struct>)
=== Структуры

#rule(<rt.value.struct.intro>)
#value-kind[@def:struct-value][Динамические типы структур]
#def("struct-value")[Структура] — значение, состоящее из набора полей некоторого @def:struct-decl[структурного типа] $T$ с их значениями.

#rule(<rt.value.struct.repr>)
Структура представляется в виде набора @def:field[полей] $T$ и соответствующих им значений.

#rule(<rt.value.struct.type>)
@def:dynamic-type структуры определяется его статическим @def:struct-decl[структурным типом] $T$.
Он привязывается к структуре в момент создания и остаётся постоянным.

#rule(<rt.value.struct.identity>)
@def:value-identity[Идентичность] множества определяется его динамическим типом и набором идентичностей значений полей.

#unresolved[
  Типы полей могут быть @def:covariant-param[ко-] и @def:contravariant-param[контравариантными] параметрами.
  Как идентичность и динамический тип взаимодействуют с ними?
]

#rule-h(<rt.cast>)
== Приведение значений к типу

#rule(<rt.cast.intro>)
Посредством @def:cast-expr[выражения приведения типов] значения могут изменять свой статический тип на указанный.
Данная операция называется #def("cast")[Приведение значения к типу][приведением значения к типу].
В ряде случаев это также сопровождается преобразованием значения одного @def:dynamic-type[динамического типа] в другой.

Аргументами операции являются @def:value[значение] $v$ и @def:type[статический тип] $T$.

#rule(<rt.cast.partial>)
Приведение значения к типу — частичная операция.
Она определена только для вариантов аргументов, указанных ниже.
Помимо них @def:processor[процессор] может доопределять операцию на других наборах аргументов.

#explanation[
  Для пар $(v, T)$, для которых операция определена ниже, процессор обязан реализовать указанное поведение.
  Доопределение допускается только тех пар, для которых данной спецификаций операция не определена.
]

#rule-h(<rt.cast.static>)
=== Статическое приведение

Если значение $v$ непосредственно содержится в типе $T$, результатом операции является $v$ без изменения.
Такое приведение называется #def("static-cast")[Статическое приведение значения к типу][статическим].

#note[
  Например, значение $4$ типа #type-expr(builtin-types.int32) может быть статически приведено к типу #type-expr(ty-union(builtin-types.int32, builtin-types.int64)) или #type-expr(builtin-types.any).
]

#rule-h(<rt.cast.int>)
=== Целочисленные преобразования

#rule(<rt.cast.int.intro>)
Если $v$ является @def:int-value[целочисленным значением], а $T$ — @def:integral-type[целочисленным типом], то операция приведения к типу осуществляет #def("int-cvt")[Целочисленное преобразование][целочисленное преобразование].

#rule(<rt.cast.int.primitive>)
Если $v$ является @def:primitive-int-value[примитивным целочисленным значением], а $T$ — @def:primitive-integer-type[примитивным целочисленным типом], то целочисленное преобразование осуществляется согласно следующей таблице:

#context {
  let primitive-types = query(<meta:primitive-int-types>).first().value
  let entry-count = primitive-types.len()
  let target-cell-header(body) = table.cell(align: bottom, rotate(-90deg, reflow: true, body))
  let cell-size = 3em

  table(
    columns: (auto, 1fr) + (cell-size,) * entry-count,
    align: center + horizon,
    rows: (auto, auto) + (cell-size,) * entry-count,

    table.header(
      table.cell(
        colspan: 2,
        rowspan: 2,
        stroke: none,
        inset: 0pt,
        line(stroke: table.stroke, start: (0%, 100%), end: (100%, 0%)),
      ),

      table.cell(align: center, colspan: entry-count)[*Тип* $T$],

      ..primitive-types
        .map(it => type-expr(builtin-types.at(it.name)))
        .map(target-cell-header),
    ),

    table.cell(rowspan: entry-count, rotate(-90deg, reflow: true)[*Динамический тип* $v$]),

    ..{
      for source-type in primitive-types {
        (type-expr(builtin-types.at(source-type.name)),)

        for target-type in primitive-types {
          let conversions = ()

          if source-type.width > target-type.width {
            conversions.push($η^#(source-type.width)_#target-type.width$)
          } else if source-type.width < target-type.width {
            conversions.push(
              $#if source-type.sign {
                $σ$
              } else {
                $ω$
              }^#(source-type.width)_#target-type.width$
            )
          }

          if source-type.sign != target-type.sign {
            conversions.push($ρ$)
          }

          if conversions.len() == 0 {
            conversions.push($=$)
          }

          let cell = $#conversions.join($;$)$

          (cell,)
        }
      }
    }
  )
}

#[
  #show terms: it => {
    grid(
      columns: (auto, 1fr),
      row-gutter: 0.65em,
      column-gutter: 2em,

      ..it.children
        .map(it => (
          it.term,
          it.description,
        ))
        .flatten(),
    )
  }

  / $=$: @def:static-cast[статическое приведение]
  / $σ_t^s$: @def:sign-ext-int-cvt[знаковое целочисленное расширение] $s$ бит до $t$
  / $ω_t^s$: @def:widen-int-cvt[беззнаковое целочисленное расширение] $s$ бит до $t$
  / $η_t^s$: @def:narrow-int-cvt[целочисленное сужение] $s$ бит до $t$
  / $ρ$: @def:reinterp-int-cvt[переинтерпретирующее преобразование]
  / $;$: композиция нескольких преобразований (применяются слева направо)
]

#rule(<rt.cast.int.enum>)
Если $v$ является значением @def:enum-decl[перечислимого типа], то преобразованию подвергается его @def:enum-underlying-value[нижележащее значение].

Если $T$ является @def:enum-decl[перечислимым типом], то в таблице выше вместо типа $T$ используется его @def:enum-underlying-type[определяющий], после чего полученное значение интерпретируется как @def:enum-underlying-value[нижележащее значение] перечислимого типа.

#rule(<rt.cast.int.notation>)
В описании дальнейших операций $v^((k))$ обозначает $k$-ый бит двоичного представления @def:primitive-int-value[примитивного целочисленного значения] $v$.
Нумерация битов начинается с $0$ в порядке от младшего к старшему.

#rule(<rt.cast.int.sign-ext>)
#def("sign-ext-int-cvt")[Знаковое целочисленное расширение] $s$ бит до $t$ — операция, которая знаковое @def:primitive-int-value[примитивное целочисленное значение] $v_1$ шириной $s$ бит преобразует в знаковое примитивное целочисленное значение $v_2$ шириной $t$ бит, где $t > s$.
$v_2$ определяется следующим образом:
+ $v_2^((k)) = v_1^((k))$ для $k in {0, ..., s - 1}$;
+ $v_2^((k)) = v_1^((s - 1))$ для $k in {s, ..., t - 1}$.

#rule(<rt.cast.int.widen>)
#def("widen-int-cvt")[Беззнаковое целочисленное расширение] $s$ бит до $t$ — операция, которая беззнаковое @def:primitive-int-value[примитивное целочисленное значение] $v_1$ шириной $s$ бит преобразует в беззнаковое примитивное целочисленное значение $v_2$ шириной $t$ бит, где $t > s$.
$v_2$ определяется следующим образом:
+ $v_2^((k)) = v_1^((k))$ для $k in {0, ..., s - 1}$;
+ $v_2^((k)) = 0$ для $k in {s, ..., t - 1}$.

#rule(<rt.cast.int.narrow>)
#def("narrow-int-cvt")[Целочисленное сужение] $s$ бит до $t$ — операция, которая @def:primitive-int-value[примитивное целочисленное значение] $v_1$ шириной $s$ бит преобразует в примитивное целочисленное значение $v_2$ шириной $t$ бит и той же знаковости, где $t < s$.
$v_2$ определяется следующим образом:
+ $v_2^((k)) = v_1^((k))$ для $k in {0, ..., t - 1}$.

#rule(<rt.cast.int.reinterp>)
#def("reinterp-int-cvt")[Переинтерпретирующее преобразование] — операция, которая @def:primitive-int-value[примитивное целочисленное значение] $v_1$ шириной $l$ бит одной знаковости преобразует в примитивное целочисленное значение $v_2$ шириной $l$ другой знаковости.
$v_2$ определяется следующим образом:
+ $v_2^((k)) = v_1^((k))$ для $k in {0, ..., l - 1}$.

#rule-h(<rt.cast.float>)
=== Вещественные преобразования

#rule(<rt.cast.float.intro>)
Если $v$ является @def:float-value[вещественным значением], а $T$ — @def:float-type[вещественным числовым типом], то операция приведения к типу осуществляет #def("float-cvt")[Вещественное преобразование][вещественное преобразование] согласно следующей таблице:

#context {
  let types = query(<meta:float-types>).first().value
  let entry-count = types.len()
  let cell-size = 5em

  table(
    columns: (auto, 1fr) + (cell-size,) * entry-count,
    align: center + horizon,
    rows: (auto, auto) + (cell-size,) * entry-count,

    table.header(
      table.cell(
        colspan: 2,
        rowspan: 2,
        stroke: none,
        inset: 0pt,
        line(stroke: table.stroke, start: (0%, 100%), end: (100%, 0%)),
      ),

      table.cell(align: center, colspan: entry-count)[*Тип* $T$],

      ..types
        .map(it => type-expr(builtin-types.at(it.name))),
    ),

    table.cell(rowspan: entry-count, rotate(-90deg, reflow: true)[*Динамический тип* $v$]),

    ..{
      for source-type in types {
        (type-expr(builtin-types.at(source-type.name)),)

        for target-type in types {
          let conversions = ()

          if source-type.width > target-type.width {
            conversions.push($Η^#(source-type.width)_#target-type.width$)
          } else if source-type.width < target-type.width {
            conversions.push($Ω^#(source-type.width)_#target-type.width$)
          }

          if conversions.len() == 0 {
            conversions.push($=$)
          }

          let cell = $#conversions.join($;$)$

          (cell,)
        }
      }
    }
  )
}

#[
  #show terms: it => {
    grid(
      columns: (auto, 1fr),
      row-gutter: 0.65em,
      column-gutter: 2em,

      ..it.children
        .map(it => (
          it.term,
          it.description,
        ))
        .flatten(),
    )
  }

  / $=$: @def:static-cast[статическое приведение]
  / $Ω_t^s$: @def:widen-float-cvt[вещественное расширение] $s$ бит до $t$
  / $Η_t^s$: @def:narrow-float-cvt[вещественное сужение] $s$ бит до $t$
]

#rule(<rt.cast.float.widen>)
#def("widen-float-cvt")[Вещественное расширение] $s$ бит до $t$ — операция, которая @def:float-value[вещественное значение] $v_1$ шириной $s$ бит преобразует в вещественное значение $v_2$ шириной $t$ бит, где $t > s$.
Определяется согласно стандарту IEEE 754@ref:ieee.

#rule(<rt.cast.float.narrow>)
#def("narrow-float-cvt")[Вещественное сужение] $s$ бит до $t$ — операция, которая @def:float-value[вещественное значение] $v_1$ шириной $s$ бит преобразует в вещественное значение $v_2$ шириной $t$ бит, где $t < s$.
Определяется согласно стандарту IEEE 754@ref:ieee.
При необходимости округление производится согласно режиму `roundTiesToEven`.

#rule-h(<rt.cast.int-float>)
=== Целочисленно-вещественное преобразование

#rule(<rt.cast.int-float.intro>)
#def("int-float-cvt")[Целочисленно-вещественное преобразование] применяется для приведения значения $v$ к типу $T$ в следующих случаях:
+ $v$ является @def:float-value[вещественным значением], а $T$ — @def:primitive-integer-type[примитивным целочисленным типом];
+ $v$ является @def:primitive-int-value[примитивным целочисленным значением], а $T$ — @def:float-type[вещественным числовой типом].

#rule(<rt.cast.int-float.float-to-int>)
Если $v$ — @def:float-value[вещественное значение], а $T$ — @def:primitive-integer-type[примитивный целочисленный тип], то результат целочисленно-вещественного преобразования — @def:primitive-int-value[примитивное целочисленное значение] $v'$, определяемое следующим образом:

+ Если $v$ — `NaN`, то $v' = 0$.

+ Если $v$ превышает (согласно сравнению в $RR$) максимальное допустимое значение $M$ типа $T$, то $v' = M$.

+ Если $v$ меньше (согласно сравнению в $RR$) минимального допустимого значения $m$ типа $T$, то $v' = m$.

+ В противном случае $v$ округляется по направлению к $0$ до ближайшего целого числа $i$. $v'$ тогда является представлением этого целого числа согласно типу $T$.

#rule(<rt.cast.int-float.int-to-float>)
Если $v$ — @def:primitive-int-value[примитивное целочисленное значение], а $T$ — @def:float-type[вещественный числовой тип], то результат целочисленно-вещественного преобразования — @def:float-value[вещественное значение] $v'$, определяемое как ближайшее представимое значение согласно стандарту IEEE 754@ref:ieee.
При необходимости округление производится согласно режиму `roundTiesToEven`.

#rule-h(<rt.ctx>)
== Контекст вычисления

#rule(<rt.ctx.intro>)
Вычисление @def:expr[выражений] происходит в #def("exec-ctx")[Контекст вычисления][контексте вычисления].
Он включает в себя окружение, стек вызовов и память.

#rule(<rt.ctx.state>)
Окружение и память формируют #def("exec-state")[Состояние вычисления][состояние].
Контекст содержит два состояния: #def("prev-exec-state")[Предыдущее состояние вычисления][предыдущее] и #def("next-exec-state")[Следующее состояние вычисления][следующее].

В каждый момент времени одно из этих состояний является #def("current-exec-state")[Текущее состояние вычисления][текущим].
По умолчанию текущим является следующее состояние, однако определённые конструкции языка позволяют производить вычисление, где текущим состоянием является предыдущее.

Аналогично контексту в данной спецификации используются понятия предыдущих, следующих и текущих значений переменных, данных по указателю и т. д.

#{
  set par(justify: false)

  figure(
    caption: [Содержание контекста вычисления],

    table(
      columns: 3,

      align: center + horizon,

      table.header(
        table.cell(stroke: none)[],
        [*Предыдущее состояние*],
        [*Следующее состояние*],
      ),

      [*Окружение*],
      [Значения глобальных и локальных переменных в *предыдущем* состоянии],
      [Значения глобальных и локальных переменных в *следующем* состоянии],

      [*Стек вызовов*],
      table.cell(colspan: 2)[*Общий* стек активных вызовов функциональных сущностей],

      [*Память*],
      [Значения по указателям в *предыдущем* состоянии],
      [Значения по указателям в *следующем* состоянии],
    )
  )
}

#rule-h(<rt.ctx.env>)
=== Окружение

#rule(<rt.ctx.env.intro>)
#def("exec-env")[Окружение] задаёт соответствие между переменными и их значениями.

#rule(<rt.ctx.env.locals>)
Окружение также означивает локальные переменные в стеке вызовов.
Значение при этом относится к конкретному стековому кадру: в разных кадрах, соответствующих вызову одной и той же функциональной сущности, значения могут отличаться.

#note[
  Можно считать, что значения хранятся непосредственно в стековых кадрах стека вызовов.
  В данной спецификации они относятся к окружению, так как значения локальных переменных разделяются на предыдущее и следующее состояния, в то время как стек вызовов для них един.
]

#rule(<rt.ctx.env.inaccessible>)
Ряд локальных переменных могут являться #def("prev-inaccessible-local")[Недоступность локальной переменной в предыдущем состоянии][недоступными в предыдущем состоянии].
Они не могут иметь @def:prev-exec-state[предыдущего] значения.

#rule-h(<rt.ctx.stack>)
=== Стек вызовов

#rule(<rt.ctx.stack.intro>)
#def("call-stack")[Стек вызовов] реализует процедурный механизм в LibSL.
Он состоит из #def("stack-frame")[Стековый кадр][стековых кадров], каждый из которых соответствует активному вызову @def:fn-entity[функциональной сущности] (@rt.call).

Каждому стековому кадру соотвествуют его @def:local-variable[локальные переменные], в том числе аргументы.
Их значения располагаются в @def:exec-env[окружении].

#rule-h(<rt.ctx.memory>)
=== Память

#rule(<rt.ctx.memory.intro>)
#def("memory")[Память] — часть контекста вычисления, содержащая значения по @def:pointer-value[указателям].
Данные значения получаются при @def:deref-expr[разыменовании] указателя.

#rule(<rt.ctx.memory.contents>)
Содержание памяти определяется @def:processor[процессором].

#note[
  LibSL не предоставляет средств для изменения данных в памяти.
]

#rule-h(<rt.init>)
== Инициализация модуля

#rule(<rt.init.intro>)
Инициализация @def:correctness[корректного модуля] — первый этап его исполнения @def:processor[процессором].
В ходе инициализации подготавливается начальный @def:exec-ctx[контекст вычисления].

Инициализация производится в следующей последовательности:
+ Инициализация @def:memory[памяти].
+ Инициализация @def:global-variable[глобальных переменных].
+ Инициализация @def:annotation[аннотаций], инициализируемых при инициализации модуля (см. @annotation.sites).

#rule-h(<rt.init.memory>)
=== Инициализация памяти

#rule(<rt.init.memory.intro>)
Инициализация @def:memory[памяти] заключается в задании значений, которые доступны по @def:pointer-value[указателям].

#rule(<rt.init.memory.structure>)
Концептуально память состоит из #def("memory-cell")[Ячейка памяти][ячеек], каждая из которых содержит некоторое @def:value[значение].
Указатели содержат #def("memory-address")[Адрес ячейки памяти][адрес] ячейки, к которой они относятся.
Данной спецификацией не определяется конкретное представление адреса.

#rule(<rt.init.memory.processor>)
Начальное содержание памяти определяется @def:processor[процессором].

#rule-h(<rt.init.var>)
=== Инициализация глобальных переменных

#rule(<rt.init.var.intro>)
Инициализация @def:global-variable[глобальных переменных] состоит в задании значений глобальных переменных в начальном @def:exec-env[окружении].

#rule(<rt.init.var.order>)
Инициализация глобальных переменных упорядочивается следующим образом:
+ Глобальные переменные без @def:variable-init-expr[инициализирующих выражений].
+ Глобальные переменные с @def:variable-init-expr[инициализирующими выражениями] в произвольном порядке, удовлетворяющем следующему ограничению:
  + Если в инициализирующем выражении глобальной переменной $v_1$ присутствует @def:name-expr[выражение имени], обращающееся к глобальной переменной $v_2$, то $v_2$ инициализируется раньше $v_1$.

#note[
  Порядок может быть установлен при помощи топологической сортировки.
]

#note[
  Упорядочение производится в пределах всего модуля.
  Порядок инициализации переменных, объявленных в одном и том же @def:source-file[исходном файле], данной спецификацией не определён.
]

#rule(<rt.init.var.no-init-expr>)
Значения глобальных переменных, не имеющих @def:variable-init-expr[инициализирующего выражения], определяются @def:processor[процессором].

#rule(<rt.init.var.init-expr>)
Значения глобальных переменных с инициализирующими выражениями устанавливаются в результате их @def:expr-eval[вычисления] в @def:exec-ctx[контексте] на момент инициализации.

#note[
  Таким образом, инициализирующие выражения могут обращаться к ранее инициализированным переменным.
]

#note[
  Так как инициализирующее выражение обязано быть @def:simple-expr[простым] (@wf.init-expr.global), их вычисление не может получить доступ к неинициализированным данным.
]

#rule-h(<rt.init.annotation>)
=== Инициализация аннотаций

#rule(<rt.init.annotation.intro>)
Во время инициализации @def:annotation[аннотаций] производится @def:expr-eval[вычисление] их аргументов.
Время, когда происходит инициализация аннотаций, определяется их местом (@annotation.sites).

#rule(<rt.init.annotation.procedure>)
При инициализации аннотации сначала вычисляются аргументы аннотации в порядке, в котором они приведены.
Затем вычисляются @def:annotation-default-expr[выражения по умолчанию] тех параметров, для которых аргументы не указаны, в порядке, в котором они следуют в @def:annotation-decl[объявлении аннотации].

#rule(<rt.init.annotation.order>)
Инициализация аннотаций производится в произвольном порядке.

#rule-h(<rt.call>)
== Вызов функциональной сущности

#rule(<rt.call.intro>)
#def("call")[Вызов] — операция $"call"_(f chevron.l P_1, ..., P_m chevron.r (p_1, ..., p_n)) chevron.l Q_1, ..., Q_m chevron.r (A)$, где:
- $f$ — @def:fn-entity[функциональная сущность], имеющая:
  - @def:type-param[типовые параметры] $P_1, ..., P_m$;
  - параметры $p_1, ..., p_n$;
- $Q_1, ..., Q_m$ — @def:type-arg[типовые аргументы];
- $A$ — значения-аргументы:
  - в случае, если $f$ является @def:static-method[нестатическим] @def:method[методом], $A = a_0, ..., a_n$;
  - иначе $A = a_1, ..., a_n$.

#rule(<rt.call.procedure>)
Вызов происходит следующим образом:

#[
  #set enum(full: true)
  + Создаётся новый @def:stack-frame[стековый кадр], который добавляется в вершину @def:call-stack[стека вызовов].

  + @def:prev-exec-state[Предыдущие] и @def:next-exec-state[следующие] значения переменных $p_1, ..., p_n$, соответствующих созданному стековому кадру, устанавливаются равными $a_1, ..., a_n$.

  + Если $f$ является @def:static-method[нестатическим] @def:method[методом], то предыдущее и следующее значение @def:this-var[переменной объекта] устанавливается равным $a_0$.

  + Вычисляется возвращённое значение следующим образом.
    Если:

    + $f$ имеет @def:annotation[аннотацию] `@intrinsic` (@annotation.builtin.intrinsic), то возвращённое значение определяется @def:processor[процессором].

    + $f$ является @def:pred-decl[функциональным предикатом]:

      + В @def:pred-body[теле] функционального предиката все использования $P_1, ..., P_m$ (в том числе неявные, устанавливаемые анализом типов) @def:type-subst[заменяются] соответственно на $Q_1, ..., Q_m$.

      + Полученное тело @def:pred-eval[вычисляется].

      + Если тело является выполненным, возвращённым значением является @def:bool-value[булево значение] `true`.

        Если тело является невыполненным, возвращённым значением является булево значение `false`.

    + $f$ является конструктором @def:struct-constructor[структурного типа]:

      + Возвращённое значение — созданная в соответствии с @decl.struct.constructor.call @def:struct-value[структура].

    + В противном случае:

      + В @def:fn-body[теле] функциональной сущности все использования $P_1, ..., P_m$ (в том числе неявные, устанавливаемые анализом типов) @def:type-subst[заменяются] соответственно на $Q_1, ..., Q_m$.

      + Если тип возвращаемого значения $f$ — #type-expr(builtin-types.void), то @def:next-exec-state[следующее] значение @def:result-var[переменной возвращаемого значения] устанавливается равным @def:void-value[значению `void`].

        В противном случае следующее значение @def:result-var[переменной возвращаемого значения] остаётся неинициализированным.

        #note[
          Так как переменная возвращаемого значения @def:prev-inaccessible-local[недоступна в предыдущем состоянии] (@decl.fn.result.prev-inaccessible), она не имеет предыдущего значения.
        ]

      + @def:block[Блок команд], составляющий полученное тело, исполняется.

      + Если @def:result-var[переменная возвращаемого значения] инициализирована, возвращённым значением является её @def:next-exec-state[следующее] значение.

        #runtime-err-def[Завершение исполнения вызванной функциональной сущности без инициализации переменной возвращаемого значения][Завершение исполнения тела без инициализации переменной возвращаемого значения — ошибка времени исполнения.]

  + С вершины @def:call-stack[стека вызовов] снимается @def:stack-frame[стековый кадр].

  + Возвращённое значение, определённое ранее, является результатом операции.
]

#rule-h(<rt.function-exec>)
== Исполнение функций

#rule(<rt.function-exec.intro>)
#def("function-execution")[Исполнение функции] — операция $"fexec"_(f chevron.l P_1, ..., P_m chevron.r (p_1, ..., p_n)) chevron.l Q_1, ..., Q_m chevron.r (A)$, где:
- $f$ — @def:function-decl[функция], @def:constructor-decl[функция-конструктор] или @def:destructor-decl[функция-деструктор];
- $P_1, ..., P_m$ — @def:type-param[типовые параметры] $f$;
- $p_1, ..., p_n$ — параметры $f$;
- $Q_1, ..., Q_m$ — @def:type-arg[типовые аргументы];
- $A$ — значения-аргументы:
  - в случае, если $f$ является @def:static-method[нестатическим] @def:method[методом], $A = a_0, ..., a_n$;
  - иначе $A = a_1, ..., a_n$.

#rule(<rt.function-exec.procedure>)
Исполнение функции происходит следующим образом:

#[
  #set enum(full: true)
  + Создаётся новый @def:stack-frame[стековый кадр], который добавляется в вершину @def:call-stack[стека вызовов].

  + @def:prev-exec-state[Предыдущие] и @def:next-exec-state[следующие] значения переменных $p_1, ..., p_n$, соответствующих созданному стековому кадру, устанавливаются равными $a_1, ..., a_n$.

  + Если $f$ является @def:static-method[нестатическим] @def:method[методом], то предыдущее и следующее значение @def:this-var[переменной объекта] устанавливается равным $a_0$.

  + В @def:fn-body[теле] функциональной сущности все использования $P_1, ..., P_m$ (в том числе неявные, устанавливаемые анализом типов) @def:type-subst[заменяются] соответственно на $Q_1, ..., Q_m$.

  + На данном шаге @def:processor[процессор] может произвести @def:pred-eval[вычисление] тел @def:requires-contract[предусловий].
    Поведение при нарушении предусловий определяется процессором.

    Если процессор не проверяет предусловий, данный шаг пропускается.

  + Если тип возвращаемого значения $f$ — #type-expr(builtin-types.void), то @def:next-exec-state[следующее] значение @def:result-var[переменной возвращаемого значения] устанавливается равным @def:void-value[значению `void`].

    В противном случае следующее значение @def:result-var[переменной возвращаемого значения] остаётся неинициализированным.

    #note[
      Так как переменная возвращаемого значения @def:prev-inaccessible-local[недоступна в предыдущем состоянии] (@decl.fn.result.prev-inaccessible), она не имеет предыдущего значения.
    ]

  + @def:block[Блок команд], составляющий полученное тело, исполняется.

  + Если @def:result-var[переменная возвращаемого значения] инициализирована, возвращённым значением является её @def:next-exec-state[следующее] значение.

    #runtime-err-def[Завершение исполнения функции без инициализации переменной возвращаемого значения][Завершение исполнения тела без инициализации переменной возвращаемого значения — ошибка времени исполнения.]

  + На данном шаге @def:processor[процессор] может произвести @def:pred-eval[вычисление] тел @def:ensures-contract[постусловий].
    Поведение при нарушении постусловий определяется процессором.

    Если процессор не проверяет постусловий, данный шаг пропускается.

  + С вершины @def:call-stack[стека вызовов] снимается @def:stack-frame[стековый кадр].

  + Если $f$ является @def:method[методом] @def:automaton-decl[автомата], а в процессе исполнения функции не встречалась @def:cancel-stmt[команда отмены перехода], то при наличии @def:applicable-shift-rule[подходящего правила перехода] @def:automaton-state[именованное состояние] автомата меняется на целевое состояние правила.

  + Возвращённое значение, определённое ранее, является результатом операции.
]

#deficiency[
  Если функция исполняется только ради контрактов, то пустой набор команд не должен выдавать ошибку.
  Процедура выше это не поддерживает.
]

#rule-h(<rt.error>)
== Ошибки времени исполнения

Во время исполнения ряд операций могут приводить к ошибочной ситуации.
Ошибка, её повлёкшая, называется ошибкой времени исполнения (@runtime-errors).

Поведение в результате ошибки времени исполнения определяется @def:processor[процессором].

#rule-h(<rt.action>)
== Семантические действия

@def:action-decl[Семантические действия] обозначают некоторую семантику, присущую описываемой библиотеке.
Поведение при исполнении семантического действия определяется @def:processor[процессором].

#rule-h(<rt.automaton-new>)
== Инстанцирование автомата

#unresolved[
  Эта секция должна описывать, что происходит при выполнении выражения `new Automaton(...)`.
  Пока это непонятно, так как неясен статус автоматов.

  Если рассуждать логически, то:
  + так как это выражение, то вычисление должно порождать значение;
  + поэтому автомат должен быть значением;
  + но тогда у него должен быть свой тип.

  В то же время в LibSL 1 автоматы, насколько я понимаю, были "оверлеем" над переменными, потому что доступ к ним происходил только с помощью выражений `Automaton(x).field`, где `x` — имя переменной.
  Указать автомат как тип при этом было нельзя.
]
